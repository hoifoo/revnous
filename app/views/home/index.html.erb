<%= render "shared/notice_banner" %>

<!-- Hero Section -->
<div class="bg-gradient-to-br from-gray-900 via-purple-900 to-pink-900 text-white py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-5xl lg:text-7xl font-bold mb-6">
        Maximize Your Revenue with<br>Strategic Sales Campaigns
      </h1>
      <p class="text-xl lg:text-2xl text-gray-300 mb-8 max-w-3xl mx-auto">
        Join <%= SocialProof::MERCHANTS_LABEL %> using Revnous to schedule sales, bulk-edit prices, and restore them automatically, now with a built-in AI assistant.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mb-4">
        <a href="https://apps.shopify.com/pricing-schedule" target="_blank" class="px-8 py-4 bg-pink-600 text-white rounded-md hover:bg-pink-700 transition font-medium text-lg" onclick="RevnousAnalytics.track('start_trial_click', { 'button_location': 'hero_section', 'app_name': 'pricing_schedule' });">
          Start Free Trial
        </a>
        <a href="https://calendar.app.google/ExeXXoFRYB52hu5S8" target="_blank" class="px-8 py-4 bg-transparent border-2 border-white text-white rounded-md hover:bg-white hover:text-gray-900 transition font-medium text-lg" onclick="RevnousAnalytics.track('book_demo_click', { 'button_location': 'hero_section', 'demo_type': 'calendar' });">
          Book a Demo
        </a>
        <%= link_to beta_signup_path, class: "px-8 py-4 bg-purple-600 text-white rounded-md hover:bg-purple-700 transition font-medium text-lg" do %>
          Join Beta Program
        <% end %>
      </div>
      <p class="text-sm text-gray-300">
        By signing up, you agree to our
        <%= link_to "Terms of Service", terms_of_service_path, class: "text-white underline hover:text-gray-100", target: "_blank" %>
        and
        <%= link_to "Privacy Policy", privacy_policy_path, class: "text-white underline hover:text-gray-100", target: "_blank" %>
      </p>
    </div>
  </div>
</div>

<!-- Stats Section -->
<div class="bg-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="sr-only">Our Impact</h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
      <% SocialProof::STATS.each do |stat| %>
        <% stat_body = capture do %>
          <p class="text-4xl lg:text-5xl font-bold text-pink-600 mb-2"><%= stat[:value] %></p>
          <p class="text-gray-600 text-lg"><%= stat[:label] %></p>
        <% end %>
        <% if stat[:url] %>
          <%= link_to stat_body, stat[:url], target: "_blank", rel: "noopener", class: "block rounded-lg hover:bg-gray-50 transition", title: "Read our reviews on the Shopify App Store" %>
        <% else %>
          <div><%= stat_body %></div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<!-- Reviews & AI Assistant Section -->
<div class="bg-gray-50 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-gray-600 uppercase tracking-wide mb-2">MERCHANT REVIEWS</p>
      <h2 class="text-4xl font-bold text-gray-900 mb-4">Loved for Fast, Human Support</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-6">
        Rated <%= SocialProof::RATING_LABEL %> by merchants who run their sales on Revnous.
      </p>
      <a href="<%= SocialProof::SHOPIFY_REVIEWS_URL %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-gray-900 font-medium hover:text-pink-600 transition">
        <span class="flex text-yellow-400" aria-hidden="true">
          <% 5.times do %>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          <% end %>
        </span>
        <span><%= SocialProof::RATING %>/5 · Read all reviews on the Shopify App Store →</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <% SocialProof::REVIEWS.each do |review| %>
        <figure class="bg-white rounded-lg p-8 shadow-sm flex flex-col">
          <svg class="w-8 h-8 text-pink-200 mb-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z"/>
          </svg>
          <blockquote class="text-gray-700 leading-relaxed flex-1">
            <p><%= review[:quote] %></p>
          </blockquote>
          <figcaption class="mt-6 text-sm">
            <span class="font-semibold text-gray-900"><%= review[:store] %></span>
            <span class="text-gray-500">· <%= review[:country] %> · Shopify App Store</span>
          </figcaption>
        </figure>
      <% end %>
    </div>

    <div class="bg-gradient-to-br from-gray-900 via-purple-900 to-pink-900 rounded-2xl p-8 md:p-12 text-white grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div>
        <p class="text-sm font-semibold text-pink-300 uppercase tracking-wide mb-2">AI ASSISTANT</p>
        <h3 class="text-3xl font-bold mb-4">Describe your sale. The assistant sets it up.</h3>
        <p class="text-gray-300 text-lg">
          Tell the built-in AI assistant what you want in plain language. It sets up the campaign for you, and original prices restore automatically when the sale ends.
        </p>
      </div>
      <div class="bg-white/10 rounded-lg p-6">
        <p class="text-xs font-semibold text-gray-300 uppercase tracking-wide mb-3">You type</p>
        <p class="text-xl font-medium">“<%= SocialProof::AI_ASSISTANT_EXAMPLE %>”</p>
      </div>
    </div>
  </div>
</div>

<!-- Featured Case Studies Section -->
<div class="bg-white py-16 border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-gray-600 uppercase tracking-wide mb-2">CASE STUDIES</p>
      <h2 class="text-4xl font-bold text-gray-900 mb-4">How Merchants Use Revnous</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        From Black Friday to a supplier price increase: real campaigns built with Revnous features
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      <% @featured_case_studies.each do |case_study| %>
        <%= link_to case_study_path(case_study), class: "block bg-white rounded-lg overflow-hidden shadow-sm hover:shadow-xl transition group" do %>
          <div class="aspect-[4/3] bg-gray-100 overflow-hidden">
            <% if case_study.display_image.present? %>
              <%= image_tag case_study.display_image,
                  alt: case_study.name,
                  class: "w-full h-full object-cover group-hover:scale-105 transition duration-300",
                  loading: :lazy
              %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center bg-gray-200">
                <span class="text-gray-400">No image</span>
              </div>
            <% end %>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-semibold text-pink-600 uppercase tracking-wide"><%= case_study.product_features %></span>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2"><%= case_study.name %></h3>
            <p class="text-gray-600 text-sm mb-4"><%= case_study.description.truncate(100) %></p>
            <div class="flex items-center gap-4 text-sm">
              <div class="flex items-center gap-1">
                <svg class="w-4 h-4 text-pink-600" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
                </svg>
                <span class="text-gray-700 font-medium"><%= case_study.conversion_rate %><% if case_study.primary_stat_label.present? %> <span class="font-normal text-gray-500"><%= case_study.primary_stat_label %></span><% end %></span>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="text-center">
      <%= link_to case_studies_path, class: "inline-flex items-center px-6 py-3 bg-gray-900 text-white rounded-md hover:bg-gray-800 transition font-medium" do %>
        View All Case Studies
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      <% end %>
    </div>
  </div>
</div>

<!-- Trusted Brands Section -->
<% if @trusted_brands.any? %>
<div class="bg-gray-50 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-center text-sm text-gray-600 mb-8">Trusted by <%= SocialProof::MERCHANTS_LABEL %></p>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 items-center opacity-60">
      <% @trusted_brands.each do |brand| %>
        <div class="flex justify-center">
          <span class="<%= brand.css_classes %> text-gray-900"><%= brand.name %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Features Section -->
<div class="bg-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold text-gray-900 mb-4">Strategic Sales Campaigns That Work</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        The tools merchants use to plan, launch, and end sales without editing prices by hand
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="text-center p-6">
        <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Scheduled Sales</h3>
        <p class="text-gray-600">Set start and end times in your store's time zone. Sales go live and end on their own</p>
      </div>

      <div class="text-center p-6">
        <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Automatic Revert</h3>
        <p class="text-gray-600">Original prices come back exactly as they were when the sale ends</p>
      </div>

      <div class="text-center p-6">
        <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Smart Product Filters</h3>
        <p class="text-gray-600">Target collections, tags, vendors, product types, price ranges, or the whole store</p>
      </div>

      <div class="text-center p-6">
        <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Campaign Reports</h3>
        <p class="text-gray-600">Compare orders during a sale with the 30 days before it started</p>
      </div>
    </div>
  </div>
</div>

<!-- Featured Products Section -->
<% if @featured_products.any? %>
<div class="bg-white py-16 border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-gray-600 uppercase tracking-wide mb-2">OUR PRODUCTS</p>
      <h2 class="text-4xl font-bold text-gray-900 mb-4">Powerful Tools for Your Business</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Discover our suite of products designed to help you maximize revenue and grow your business
      </p>
    </div>

    <div class="space-y-16">
      <% @featured_products.each_with_index do |product, index| %>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center <%= 'lg:flex-row-reverse' if index.odd? %>">
          <!-- Product Info Column -->
          <div class="<%= 'lg:order-2' if index.odd? %>">
            <% if product.logo.attached? %>
              <div class="mb-6">
                <%= image_tag product.logo, class: "h-16 w-auto object-contain", loading: :lazy, alt: product.name %>
              </div>
            <% end %>

            <h3 class="text-4xl font-bold text-gray-900 mb-4">
              <%= product.name %>
            </h3>

            <% if product.product_type.present? %>
              <span class="inline-block px-3 py-1 bg-pink-100 text-pink-700 text-xs font-semibold rounded-full uppercase tracking-wide mb-4">
                <%= product.product_type %>
              </span>
            <% end %>

            <% if product.description.present? %>
              <p class="text-lg text-gray-600 mb-6">
                <%= product.description %>
              </p>
            <% elsif product.short_description.present? %>
              <p class="text-lg text-gray-600 mb-6">
                <%= product.short_description %>
              </p>
            <% end %>

            <div class="flex gap-4 mb-3">
              <a href="https://calendar.app.google/ExeXXoFRYB52hu5S8" target="_blank" class="inline-flex items-center px-6 py-3 bg-pink-600 text-white rounded-md hover:bg-pink-700 transition font-medium" onclick="RevnousAnalytics.track('book_demo_click', { 'button_location': 'product_section', 'product_name': '<%= product.name.gsub("'", "\\'") %>', 'demo_type': 'calendar' });">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                Schedule a Demo
              </a>

              <%= link_to product, class: "inline-flex items-center px-6 py-3 bg-gray-900 text-white rounded-md hover:bg-gray-800 transition font-medium", onclick: "RevnousAnalytics.track('learn_more_click', { 'button_location': 'product_section', 'product_name': '#{product.name.gsub("'", "\\'")}' });" do %>
                Learn More
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              <% end %>
            </div>

            <p class="text-xs text-gray-500">
              See our
              <%= link_to "Terms of Service", terms_of_service_url_for(product), class: "text-pink-600 hover:text-pink-700 underline", target: "_blank" %>
              and
              <%= link_to "Privacy Policy", privacy_policy_url_for(product), class: "text-pink-600 hover:text-pink-700 underline", target: "_blank" %>
            </p>
          </div>

          <!-- Product Cover Photo Column -->
          <div class="<%= 'lg:order-1' if index.odd? %>">
            <% if product.cover_photo.attached? %>
              <div class="rounded-lg overflow-hidden shadow-xl">
                <%= image_tag product.cover_photo, alt: product.name, class: "w-full h-full object-cover", loading: :lazy %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Featured Blogs Section -->
<% if @featured_blogs.any? %>
<div class="bg-gray-50 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-gray-600 uppercase tracking-wide mb-2">LATEST INSIGHTS</p>
      <h2 class="text-4xl font-bold text-gray-900 mb-4">From Our Blog</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Expert tips and proven strategies to grow your eCommerce business
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-<%= [@featured_blogs.count, 3].min %> gap-8 mb-8">
      <% @featured_blogs.each do |blog| %>
        <%= link_to blog_path(blog.slug), class: "block bg-white rounded-lg overflow-hidden shadow-sm hover:shadow-xl transition group" do %>
          <div class="aspect-[16/10] bg-gray-100 overflow-hidden">
            <% if blog.image.attached? %>
              <%= image_tag blog.image,
                  alt: blog.title,
                  class: "w-full h-full object-cover group-hover:scale-105 transition duration-300",
                  loading: :lazy
              %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-pink-100 to-purple-100">
                <span class="text-gray-400">No image</span>
              </div>
            <% end %>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-3 mb-3">
              <% if blog.category.present? %>
                <span class="px-3 py-1 bg-pink-100 text-pink-700 text-xs font-semibold rounded-full uppercase tracking-wide">
                  <%= blog.category %>
                </span>
              <% end %>
              <span class="text-xs text-gray-500">
                <%= blog.published_at.strftime("%b %d, %Y") %>
              </span>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-pink-600 transition">
              <%= blog.title %>
            </h3>
            <p class="text-gray-600 text-sm mb-4">
              <%= blog.excerpt&.truncate(120) %>
            </p>
            <div class="flex items-center text-pink-600 font-medium text-sm">
              Read more
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="text-center">
      <%= link_to blogs_path, class: "inline-flex items-center px-6 py-3 bg-gray-900 text-white rounded-md hover:bg-gray-800 transition font-medium" do %>
        View All Blog Posts
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Special Offer Section -->
<% if @special_offer %>
<div class="bg-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="bg-black rounded-2xl p-16 flex items-center justify-center">
        <div class="text-center">
          <% if @special_offer.logo_text.present? %>
            <svg class="w-48 h-48 mx-auto text-white" viewBox="0 0 200 200" fill="currentColor">
              <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" class="text-6xl font-bold">
                <%= @special_offer.logo_text %>
              </text>
            </svg>
          <% end %>
        </div>
      </div>
      <div>
        <% if @special_offer.subtitle.present? %>
          <p class="text-xs font-semibold text-pink-600 uppercase tracking-wide mb-4"><%= @special_offer.subtitle %></p>
        <% end %>
        <h2 class="text-4xl font-bold text-gray-900 mb-6"><%= @special_offer.title %></h2>
        <% if @special_offer.description.present? %>
          <p class="text-lg text-gray-600 mb-6"><%= @special_offer.description %></p>
        <% end %>
        <% if @special_offer.terms_text.present? %>
          <p class="text-sm text-gray-500 mb-6"><%= @special_offer.terms_text %></p>
        <% end %>
        <% if @special_offer.cta_url.present? %>
          <a href="<%= @special_offer.cta_url %>" target="_blank" class="inline-block px-6 py-3 bg-pink-600 text-white rounded-md hover:bg-pink-700 transition font-medium">
            <%= @special_offer.cta_text || 'Get the offer' %>
          </a>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% end %>

<!-- Partners Section -->
<% if @partners.any? %>
<div class="bg-gray-50 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-gray-600 uppercase tracking-wide mb-2">OUR PARTNERS</p>
      <h2 class="text-4xl font-bold text-gray-900 mb-4">Trusted by Industry Leaders</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Working with the best partners to deliver exceptional results
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-<%= [@partners.count, 6].min %> gap-8 items-center">
      <% @partners.each do |partner| %>
        <% if partner.website_url.present? %>
          <a href="<%= partner.website_url %>" target="_blank" class="flex justify-center items-center p-6 bg-white rounded-lg hover:shadow-lg transition group" title="<%= partner.name %>">
            <% if partner.logo.attached? %>
              <%= image_tag partner.logo, alt: partner.name, class: "h-16 w-auto max-w-full object-contain grayscale group-hover:grayscale-0 transition", loading: :lazy %>
            <% else %>
              <span class="text-xl font-bold text-gray-700 group-hover:text-gray-900"><%= partner.name %></span>
            <% end %>
          </a>
        <% else %>
          <div class="flex justify-center items-center p-6 bg-white rounded-lg" title="<%= partner.name %>">
            <% if partner.logo.attached? %>
              <%= image_tag partner.logo, alt: partner.name, class: "h-16 w-auto max-w-full object-contain grayscale", loading: :lazy %>
            <% else %>
              <span class="text-xl font-bold text-gray-700"><%= partner.name %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Contact Us Section -->
<div id="contact-us" class="bg-white py-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-5xl font-bold text-gray-900 mb-4">Get in Touch</h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Have questions? We'd love to hear from you. Send us a message and we'll respond as soon as possible.
      </p>
      <div class="mt-6">
        <p class="text-gray-600 mb-2">Or email us directly at:</p>
        <a href="mailto:hello@revnous.com" class="text-2xl font-semibold text-pink-600 hover:text-pink-700 transition">
          hello@revnous.com
        </a>
      </div>
    </div>

    <div class="bg-gray-50 rounded-2xl p-8 md:p-12 shadow-lg">
      <%= form_with url: contact_path, method: :post, scope: :contact, class: "space-y-6", id: "contact-form" do |form| %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= form.label :name, "Your Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_field :name, required: true, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500 focus:border-transparent text-lg", placeholder: "John Doe" %>
          </div>

          <div>
            <%= form.label :email, "Email Address", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.email_field :email, required: true, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500 focus:border-transparent text-lg", placeholder: "john@example.com" %>
          </div>
        </div>

        <div>
          <%= form.label :company, "Company Name (Optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.text_field :company, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500 focus:border-transparent text-lg", placeholder: "Your Company" %>
        </div>

        <div>
          <%= form.label :subject, "Subject", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.text_field :subject, required: true, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500 focus:border-transparent text-lg", placeholder: "How can we help?" %>
        </div>

        <div>
          <%= form.label :message, "Message", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.text_area :message, required: true, rows: 6, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500 focus:border-transparent text-lg", placeholder: "Tell us more about your needs..." %>
        </div>

        <!-- ALTCHA CAPTCHA Widget -->
        <div class="flex justify-center">
          <altcha-widget
            challengeurl="<%= altcha_challenge_path %>"
            hidelogo="false"
            name="altcha"
          ></altcha-widget>
        </div>

        <div class="text-center">
          <%= form.submit "Send Message", class: "px-12 py-4 bg-pink-600 text-white text-lg font-semibold rounded-lg hover:bg-pink-700 transition cursor-pointer shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-pink-600", id: "submit-btn", disabled: true %>
        </div>
      <% end %>
    </div>

    <!-- ALTCHA Widget Script (now bundled in application.js) -->
    <script>
      // Wait for custom element to be defined
      if (customElements && customElements.whenDefined) {
        customElements.whenDefined('altcha-widget').then(() => {
          console.log('ALTCHA widget is ready (homepage)');
          setupAltchaListenerHomepage();
        });
      } else {
        // Fallback for older browsers
        document.addEventListener('DOMContentLoaded', setupAltchaListenerHomepage);
      }

      function setupAltchaListenerHomepage() {
        const submitBtn = document.getElementById('submit-btn');
        const altchaWidget = document.querySelector('altcha-widget');

        console.log('Setting up ALTCHA listener (homepage)');
        console.log('Submit button:', submitBtn);
        console.log('ALTCHA widget:', altchaWidget);

        if (!submitBtn) {
          console.error('Submit button not found!');
          return;
        }

        if (!altchaWidget) {
          console.error('ALTCHA widget not found!');
          return;
        }

        // Listen for ALTCHA verification events
        altchaWidget.addEventListener('statechange', (event) => {
          console.log('ALTCHA state changed (homepage):', event.detail);

          // Enable button when ALTCHA is verified
          if (event.detail.state === 'verified') {
            console.log('ALTCHA verified - enabling button');
            submitBtn.disabled = false;
            submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            submitBtn.classList.add('cursor-pointer');
          } else {
            console.log('ALTCHA not verified - disabling button');
            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
            submitBtn.classList.remove('cursor-pointer');
          }
        });

        console.log('ALTCHA listener attached successfully (homepage)');
      }
    </script>
  </div>
</div>

